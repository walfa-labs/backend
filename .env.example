# Application
APP_ENV=development
APP_PORT=:8080

# Oracle Autonomous Transaction Processing (operational OLTP store).
# godror connect string: user/password@tns_alias from the wallet's tnsnames.ora.
ATP_DSN=portfolio/change-me@portfolio_atp_high

# Oracle Autonomous Data Warehouse (analytics store: view events, stats).
ADW_DSN=portfolio/change-me@portfolio_adw_high

# Directory containing the unzipped Autonomous DB wallet (tnsnames.ora,
# cwallet.sso, ...). Read directly by the Oracle client (ODPI), not the app.
# One wallet per DB — point TNS_ADMIN at a dir that contains both aliases,
# or use a shared wallet.
TNS_ADMIN=./wallet

# golang-migrate URLs used by `task migrate-up` / `task migrate-down`
# (oracle:// scheme for the golang-migrate oracle driver; URL-encode the
# password if it contains special characters).
MIGRATE_ATP_URL=oracle://portfolio:change-me@portfolio_atp_high
MIGRATE_ADW_URL=oracle://portfolio:change-me@portfolio_adw_high

# JWT
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Admin credentials (ADMIN_PASSWORD_HASH is a bcrypt hash, not plaintext)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2a$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy'

# OCI Object Storage (asset blobs). The API key PEM must be unencrypted.
# OCI_NAMESPACE is optional — resolved via the GetNamespace API when empty.
OCI_TENANCY_OCID=ocid1.tenancy.oc1..change-me
OCI_USER_OCID=ocid1.user.oc1..change-me
OCI_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
OCI_REGION=ap-singapore-1
OCI_PRIVATE_KEY_PATH=./oci_api_key.pem
OCI_NAMESPACE=
OCI_BUCKET=portfolio-assets

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000
