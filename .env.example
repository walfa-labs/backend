# Application
APP_ENV=development
APP_PORT=:8080

# Database
DATABASE_URL=postgres://portfolio:dev@localhost:5432/portfolio?sslmode=disable

# JWT
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Admin credentials (ADMIN_PASSWORD_HASH is a bcrypt hash, not plaintext)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy

# Object Storage (S3-compatible: MinIO, R2, S3)
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_BUCKET=portfolio-assets
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=minio123
OBJECT_STORAGE_USE_PATH_STYLE=true

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000
