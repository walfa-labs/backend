# Application
APP_ENV=development
APP_PORT=:8080

# ============================================================
# Database Driver: "postgres" or "oracle"
# ============================================================
DB_DRIVER=postgres

# ============================================================
# Option A: PostgreSQL (local Docker or managed PostgreSQL)
# ============================================================
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=portfolio
# DB_PASSWORD=devpassword
# DB_NAME=portfolio
# DB_SSLMODE=disable
# MIGRATE_URL=postgres://portfolio:devpassword@localhost:5432/portfolio?sslmode=disable

# ============================================================
# Option B: Oracle 23ai Free (local Docker — requires Oracle Instant Client on host)
# ============================================================
# DB_DRIVER=oracle
# DB_HOST=localhost
# DB_PORT=1521
# DB_USER=portfolio_atp
# DB_PASSWORD=devpassword
# DB_NAME=FREEPDB1
#
# # Optional: separate Oracle ADW for analytics. Omit to reuse the main DB connection.
# # ANALYTICS_DB_HOST=localhost
# # ANALYTICS_DB_PORT=1521
# # ANALYTICS_DB_USER=portfolio_adw
# # ANALYTICS_DB_PASSWORD=devpassword
# # ANALYTICS_DB_NAME=FREEPDB1
# # MIGRATE_ANALYTICS_URL=oracle://portfolio_adw:devpassword@localhost:1521/FREEPDB1
# MIGRATE_URL=oracle://portfolio_atp:devpassword@localhost:1521/FREEPDB1

# ============================================================
# Option C: Oracle Cloud ATP/ADW (production)
# ============================================================
# DB_DRIVER=oracle
# DB_HOST=<adb-hostname>
# DB_PORT=1522
# DB_USER=portfolio_atp
# DB_PASSWORD=<secret>
# DB_NAME=<service-name>_high          # TNS alias from wallet
# ANALYTICS_DB_HOST=<adw-hostname>
# ANALYTICS_DB_PORT=1522
# ANALYTICS_DB_USER=portfolio_adw
# ANALYTICS_DB_PASSWORD=<secret>
# ANALYTICS_DB_NAME=<adw-service-name>_high
# MIGRATE_URL=oracle://portfolio_atp:<password>@<host>:1522/<service>
# MIGRATE_ANALYTICS_URL=oracle://portfolio_adw:<password>@<adw-host>:1522/<adw-service>

# ============================================================
# Shared
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=portfolio
DB_PASSWORD=devpassword
DB_NAME=portfolio
DB_SSLMODE=disable
MIGRATE_URL=postgres://portfolio:devpassword@localhost:5432/portfolio?sslmode=disable

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Admin credentials — generate hash: htpasswd -bnBC 10 "" yourpassword | tr -d ':\n'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=required

# Asset Storage Backend ("local" or "oci")
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BASE_URL=http://localhost:8080/uploads

# OCI Object Storage (only required when STORAGE_DRIVER=oci)
# OCI_TENANCY_OCID=ocid1.tenancy.oc1..change-me
# OCI_USER_OCID=ocid1.user.oc1..change-me
# OCI_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
# OCI_REGION=ap-singapore-1
# OCI_PRIVATE_KEY_PATH=./oci_api_key.pem
# OCI_NAMESPACE=
# OCI_BUCKET=portfolio-assets

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000
